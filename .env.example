# Required: absolute path to the directory containing application repositories.
HOMEBASE_WORKSPACE_PATH=/absolute/path/to/projects

# Required: absolute path to an existing, writable directory HomeBase uses for
# its own log file and one writable subdirectory per configured application
# (<HOMEBASE_DATA_PATH>/homebase/log/homebase.ndjson,
# <HOMEBASE_DATA_PATH>/apps/<applicationId>/).
HOMEBASE_DATA_PATH=/absolute/path/to/data

# Optional: overrides server.port from config/homebase.json.
# HOMEBASE_PORT=17106

# Optional: absolute path or path relative to the HomeBase project root.
# HOMEBASE_CONFIG_PATH=config/homebase.json

# Optional: informational public origin surfaced to hosted adapters as
# HostedApplicationOptions.hostOrigin. Not validated beyond non-empty.
# HOMEBASE_PUBLIC_ORIGIN=https://homebase.example.com

# Optional: minimum level written to the NDJSON log and mirrored to the
# console outside production. One of trace|debug|info|warn|error|fatal.
# Defaults to info.
# HOMEBASE_LOG_LEVEL=info
