{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebase.local/schemas/homebase.schema.json",
  "title": "HomeBase configuration",
  "description": "Configuration for the HomeBase listener and explicitly registered hosted applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "server",
    "applications"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "HomeBase configuration schema version."
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 17106,
          "description": "HomeBase listener port when HOMEBASE_PORT is not set."
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/application"
      },
      "default": []
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:/|$))(?!/)(?!.*\\\\).+$",
      "description": "A forward-slash relative path with no dot or parent-traversal segments."
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "slug",
        "enabled",
        "repoPath",
        "adapterPath",
        "contractVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "$ref": "#/$defs/identifier"
        },
        "enabled": {
          "type": "boolean"
        },
        "repoPath": {
          "$ref": "#/$defs/relativePath"
        },
        "adapterPath": {
          "$ref": "#/$defs/relativePath"
        },
        "contractVersion": {
          "const": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "string",
          "minLength": 1
        },
        "devCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Informational standalone commands. HomeBase does not execute them."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "sortOrder": {
          "type": "integer"
        }
      }
    }
  }
}
